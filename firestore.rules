rules_version = '2';

// Scrabble deipovery — regole Firestore
// Copia tutto questo testo nella scheda "Regole" di Firestore Database e premi "Pubblica".
service cloud.firestore {
  match /databases/{database}/documents {

    // Profilo: ognuno legge/scrive solo il proprio (per ora c'è solo il nickname).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Sottoscrizione alle notifiche push: ognuno scrive/cancella solo la propria.
    // Un documento si può leggere conoscendo l'uid (niente elenco): serve al Worker,
    // che lo legge con il token di chi ha appena mosso. Da sola non permette di
    // inviare nulla: per mandare notifiche serve la chiave privata VAPID del Worker.
    match /pushSubs/{uid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.matches('https://.*')
        && request.resource.data.p256dh is string
        && request.resource.data.auth is string;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Inviti: si legge un invito solo conoscendo il codice (niente elenco),
    // si crea una volta sola e non si può più modificare.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.gameId is string;
      allow update, delete: if false;
    }

    match /games/{gameId} {

      // Leggere una partita: solo i due giocatori. Unica eccezione: una partita ancora
      // "in attesa" si può aprire per agganciarsi (l'ID è lungo e non indovinabile,
      // e si arriva qui solo tramite il codice d'invito).
      allow get: if request.auth != null
        && (request.auth.uid in resource.data.players || resource.data.status == 'waiting');

      // Elenco partite: solo quelle in cui ci sei tu.
      allow list: if request.auth != null && request.auth.uid in resource.data.players;

      // Creare: o una partita in attesa con te come unico giocatore,
      // o una rivincita già attiva con te e l'altro giocatore.
      allow create: if request.auth != null
        && request.resource.data.players[0] == request.auth.uid
        && ((request.resource.data.players.size() == 1 && request.resource.data.status == 'waiting')
         || (request.resource.data.players.size() == 2 && request.resource.data.status == 'active'));

      allow update: if request.auth != null && (

        // (a) Aggancio: chi apre l'invito diventa il secondo giocatore.
        (resource.data.status == 'waiting'
          && resource.data.players.size() == 1
          && request.resource.data.players.size() == 2
          && request.resource.data.players[0] == resource.data.players[0]
          && request.resource.data.players[1] == request.auth.uid
          && request.resource.data.status == 'active')

        ||

        // (b) Giocatori: i due giocatori non si possono cambiare e la versione non torna
        // indietro. Aumentare la versione (= fare una mossa) è permesso solo a chi ha il
        // turno, oppure a chiunque dei due se la mossa chiude la partita (resa).
        (request.auth.uid in resource.data.players
          && request.resource.data.players == resource.data.players
          && request.resource.data.version >= resource.data.version
          && (request.resource.data.version == resource.data.version
              || resource.data.turnUid == request.auth.uid
              || request.resource.data.status == 'finished'))
      );

      allow delete: if false;
    }
  }
}
